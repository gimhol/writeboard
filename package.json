{
  "name": "@fimagine/writeboard",
  "version": "0.2.0",
  "description": "Extensible whiteboard for writing, with zero runtime dependencies. 可扩展的书写用白板，不依赖任何第三方库。",
  "main": "dist/es6/cjs/writeboard.js",
  "module": "dist/es6/es/writeboard.js",
  "types": "dist/es6/cjs/writeboard.d.ts",
  "style": "dist/es6/cjs/writeboard.css",
  "unpkg": "dist/es6/umd/writeboard.js",
  "jsdelivr": "dist/es6/umd/writeboard.js",
  "exports": {
    ".": {
      "types": "./dist/es6/cjs/writeboard.d.ts",
      "import": "./dist/es6/es/writeboard.js",
      "require": "./dist/es6/cjs/writeboard.js",
      "default": "./dist/es6/cjs/writeboard.js"
    },
    "./dist/*": "./dist/*",
    "./writeboard/*": "./writeboard/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "writeboard"
  ],
  "keywords": [
    "whiteboard",
    "canvas",
    "drawing",
    "handwriting",
    "白板",
    "画板",
    "typescript"
  ],
  "scripts": {
    "start": "npm run demo",
    "pretest": "npm run build",
    "test": "mocha",
    "demo": "rollup -c -w --environment output_format:cjs",
    "build": "rollup -c",
    "doc": "typedoc --out typedoc writeboard/index.ts",
    "deploy": "fdeploy -s main",
    "flow": "npm run build && npm run deploy"
  },
  "author": "Gim",
  "license": "Apache-2.0",
  "devDependencies": {
    "@fimagine/frontend_deployer": "^1.0.7",
    "@rollup/plugin-html": "^2.0.0",
    "@rollup/plugin-image": "^3.0.3",
    "browserify": "^17.0.1",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.1",
    "postcss": "^8.5.6",
    "postcss-scss": "^4.0.9",
    "rollup": "^4.44.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^3.0.1",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "sass": "^1.89.2",
    "typedoc": "^0.28.7",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/gimholg/writeboard.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
